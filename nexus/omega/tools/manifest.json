{
  "version": 1,
  "agent": "OMEGA",
  "tools": [
    {
      "name": "web_search",
      "module": "web",
      "description": "Live-Websuche (DuckDuckGo/Bing/Wikipedia) mit echten Treffern, Quellen und Datum. Keine erfundenen Ergebnisse.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "maxLength": 500},
          "limit": {"type": "integer", "minimum": 1, "maximum": 20},
          "news": {"type": "boolean"}
        },
        "required": ["query"]
      },
      "permission": "read",
      "destructive": false,
      "rate": {"limit": 30, "window_s": 60},
      "tags": ["web", "research"]
    },
    {
      "name": "fetch_page",
      "module": "web",
      "description": "Webseite laden, lesbaren Text extrahieren, sanitisieren und optional in den lokalen RAG-Speicher schreiben.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "maxLength": 2000},
          "max_chars": {"type": "integer", "minimum": 1000, "maximum": 120000},
          "save": {"type": "boolean"}
        },
        "required": ["url"]
      },
      "permission": "read",
      "destructive": false,
      "rate": {"limit": 30, "window_s": 60},
      "tags": ["web", "research"]
    },
    {
      "name": "rag_add",
      "module": "web",
      "description": "Dokument in den lokalen FTS5-RAG-Speicher aufnehmen.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {"type": "string", "maxLength": 500},
          "title": {"type": "string", "maxLength": 500},
          "content": {"type": "string", "maxLength": 400000},
          "meta": {"type": "object"}
        },
        "required": ["content"]
      },
      "permission": "write",
      "destructive": false,
      "rate": {"limit": 60, "window_s": 60},
      "tags": ["rag", "memory"]
    },
    {
      "name": "rag_search",
      "module": "web",
      "description": "Lokalen RAG-Speicher durchsuchen (FTS5, Fallback LIKE).",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "maxLength": 500},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50}
        },
        "required": ["query"]
      },
      "permission": "read",
      "destructive": false,
      "rate": {"limit": 60, "window_s": 60},
      "tags": ["rag", "memory"]
    },
    {
      "name": "slack_post",

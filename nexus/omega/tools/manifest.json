    },
    {
      "name": "run_python",
      "module": "code",
      "description": "Python-Code in der isolierten Sandbox ausfuehren (Docker, sonst nur mit expliziter Freigabe).",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "maxLength": 200000},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 60},
          "stdin": {"type": "string", "maxLength": 20000}
        },
        "required": ["code"]
      },
      "permission": "write",
      "destructive": false,
      "rate": {"limit": 20, "window_s": 60},
      "tags": ["code", "sandbox"]
    },
    {
      "name": "lint_python",
      "module": "code",
      "description": "Python-Code statisch pruefen (Syntax/AST, gefaehrliche Muster).",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "maxLength": 200000}
        },
        "required": ["code"]
      },
      "permission": "read",
      "destructive": false,
      "rate": {"limit": 60, "window_s": 60},
      "tags": ["code"]
    },
    {
      "name": "write_code",
      "module": "code",
      "description": "Code-Datei im OMEGA-Sandboxverzeichnis speichern (kein Zugriff ausserhalb).",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "maxLength": 300},
          "code": {"type": "string", "maxLength": 200000}
        },
        "required": ["path", "code"]
      },
      "permission": "write",
      "destructive": false,
      "lint_params": ["code"],
      "rate": {"limit": 30, "window_s": 60},
      "tags": ["code", "sandbox"]
    },

      "parameters": {
        "type": "object",
        "properties": {
          "channel": {"type": "string", "maxLength": 200},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50}
        },
        "required": ["channel"]
      },
      "permission": "read",
      "destructive": false,
      "rate": {"limit": 30, "window_s": 60},
      "tags": ["slack", "productivity"]
    },
    {
      "name": "slack_channels",

          "thread_ts": {"type": "string", "maxLength": 100}
        },
        "required": ["text"]
      },
      "permission": "external",
      "destructive": true,
      "rate": {"limit": 20, "window_s": 60},
      "tags": ["slack", "productivity", "external"]
    },
    {
      "name": "slack_read",
      "module": "slack",

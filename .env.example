# Kopiere nach .env und trage eigene Werte ein. Niemals .env committen.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8299
# Optional: zusätzliche Browser-Origins (kommagetrennt), z. B. http://wozipc-nexus:8299
NEXUS_CORS_ORIGINS=
OLLAMA_HOST=http://127.0.0.1:11434
NEXUS_MODEL=qwen3.5:9b
# Optional: Geraete im eigenen Tailscale-/LAN-Netz (Platzhalter 192.0.2.x im Code ersetzen)
NEXUS_PC_HOST=
NEXUS_PHONE_HOST=
# Optional: Mail (App-Passwort nur hier, nie im Code)
NEXUS_IMAP_HOST=
NEXUS_SMTP_HOST=
NEXUS_MAIL_USER=
NEXUS_MAIL_APP_PASSWORD=
# Optional: Tailscale-IP des Handys (adb connect / NEXUS OS Link)
NEXUS_PHONE_TAILSCALE_IP=
